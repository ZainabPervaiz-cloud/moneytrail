# Copy this file to ".env" and fill in real values. ".env" itself is
# git-ignored so secrets never get committed.

# Database connection string.
# Local dev default (SQLite, no setup needed):
DATABASE_URL=sqlite:///./finance_tracker.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/finance_tracker

# Secret key used to sign JWT auth tokens. Generate a real random value
# for production, e.g. with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# How long an access token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
